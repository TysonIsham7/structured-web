{
  "version": "0.1.0",
  "id": "urn:example:resource:article:update",
  "type": "article",
  "title": "Example resource",
  "content": {
    "body": "A reference article used to illustrate a high-risk action. The action applies a declared update when the caller is authenticated and the resource is published.",
    "summary": "High-risk update on a domain-neutral article."
  },
  "actions": [
    {
      "name": "update_resource",
      "description": "Apply a declared update to this resource.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["note"],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["result_id", "status"],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "preconditions": ["user.is_authenticated", "resource.is_published"],
      "effects": ["resource.updated"],
      "risk": "high",
      "idempotent": false
    }
  ],
  "links": [
    {
      "rel": "related",
      "href": "https://example.com/articles/getting-started",
      "title": "Getting started with structured resources"
    }
  ],
